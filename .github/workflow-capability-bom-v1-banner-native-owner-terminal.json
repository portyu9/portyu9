{
  "automationPolicyId": "automation-policy-v1",
  "bomId": "workflow-capability-bom-v1",
  "repository": "portyu9/portyu9",
  "schemaVersion": 1,
  "workflows": [
    {
      "id": "banner-native-owner-terminal",
      "jobs": [
        {
          "actions": [
            {
              "kind": "remote",
              "path": "",
              "ref": "3d3c42e5aac5ba805825da76410c181273ba90b1",
              "repository": "actions/checkout",
              "step": "Checkout immutable trusted main without persistent credential"
            },
            {
              "kind": "remote",
              "path": "",
              "ref": "6d4fd22b20465ccc0f7354476588e8df7c9ca0e0",
              "repository": "actions/setup-python",
              "step": "Set up Python"
            },
            {
              "kind": "remote",
              "path": "",
              "ref": "cf430e030ddbb5b0abf93d22962f4752f3646cd9",
              "repository": "actions/upload-artifact",
              "step": "Upload exact owner receipt"
            }
          ],
          "apiSurfaces": [
            {
              "client": "gh-api",
              "endpoint": "repos/$GITHUB_REPOSITORY/actions/artifacts/$ARTIFACT_ID/zip",
              "method": "GET",
              "mutating": false,
              "step": "Approve exact current-day banner as owner"
            },
            {
              "client": "gh-api",
