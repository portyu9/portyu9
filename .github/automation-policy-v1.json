{
  "schemaVersion": 1,
  "policyId": "automation-policy-v1",
  "repository": "portyu9/portyu9",
  "branches": {
    "main": "main",
    "generated": "generated",
    "spotlightCandidatePrefix": "automation/spotlight-links/"
  },
  "githubActionsAppId": 15368,
  "rulesetContract": ".github/rulesets/repository-rulesets-v1.json",
  "workflows": {
    "codeql": {
      "path": ".github/workflows/codeql.yml",
      "triggers": ["pull_request", "push", "schedule", "workflow_dispatch"],
      "permissions": {
        "contents": "read"
      },
      "jobs": {
        "analyze": {
          "name": "analyze-${{ matrix.language }}",
          "needs": [],
          "permissions": {
            "contents": "read",
            "security-events": "write"
          }
        }
      }
    },
    "dependency-review": {
      "path": ".github/workflows/dependency-review.yml",
      "triggers": ["pull_request"],
      "permissions": {
        "contents": "read"
      },
      "jobs": {
        "dependency-review": {
          "name": "dependency-review",
          "needs": [],
          "permissions": {
            "contents": "read"
          }
        }
      }
    },
    "profile-quality": {
      "path": ".github/workflows/profile-quality.yml",
      "triggers": ["pull_request", "push"],
      "permissions": {
        "contents": "read"
      },
      "jobs": {
        "validate": {
          "name": "validate-contracts",
          "needs": [],
          "permissions": {
            "contents": "read"
          }
        },
        "integration": {
          "name": "integration-pinned-upstream",
          "needs": [],
          "permissions": {
            "contents": "read"
          }
        }
      }
    },
    "profile-stats": {
      "path": ".github/workflows/profile-stats.yml",
      "triggers": ["push", "schedule", "workflow_dispatch"],
      "permissions": {
        "contents": "read"
      },
      "jobs": {
        "generate": {
          "name": "generate-read-only",
          "needs": [],
          "permissions": {
            "contents": "read"
          }
        },
        "attest": {
          "name": "prepare-attestation-read-only",
          "needs": ["generate"],
          "permissions": {
            "contents": "read"
          }
        },
        "attest_publish": {
          "name": "attest-write-only",
          "needs": ["attest"],
          "permissions": {
            "contents": "read",
            "id-token": "write",
            "attestations": "write"
          }
        },
        "stage": {
          "name": "stage-publication-read-only",
          "needs": ["generate", "attest", "attest_publish"],
          "permissions": {
            "contents": "read"
          }
        },
        "publish": {
          "name": "publish-write-only",
          "needs": ["stage"],
          "permissions": {
            "contents": "write"
          }
        },
        "dispatch": {
          "name": "dispatch-spotlight-link-sync",
          "needs": ["publish"],
          "permissions": {
            "actions": "write"
          }
        }
      }
    },
    "spotlight-link-sync": {
      "path": ".github/workflows/spotlight-link-sync.yml",
      "triggers": ["schedule", "workflow_dispatch"],
      "permissions": {
        "contents": "read"
      },
      "jobs": {
        "plan": {
          "name": "plan-direct-links-read-only",
          "needs": [],
          "permissions": {
            "contents": "read"
          }
        },
        "budget": {
          "name": "mutation-budget-read-only",
          "needs": ["plan"],
          "permissions": {
            "actions": "read"
          }
        },
        "quarantine": {
          "name": "mutation-budget-quarantine-read-only",
          "needs": ["plan", "budget"],
          "permissions": {
            "contents": "read"
          }
        },
        "propose": {
          "name": "propose-readme-only-write",
          "needs": ["plan", "budget"],
          "permissions": {
            "contents": "write",
            "pull-requests": "write"
          }
        },
        "approve": {
          "name": "approve-bot-pr-checks-only",
          "needs": ["plan", "budget", "propose"],
          "permissions": {
            "contents": "read",
            "actions": "write"
          }
        },
        "merge": {
          "name": "merge-readme-only-terminal-write",
          "needs": ["plan", "budget", "propose", "approve"],
          "permissions": {
            "contents": "write",
            "pull-requests": "read",
            "checks": "read"
          }
        }
      }
    }
  },
  "transactionMachines": {
    "profile-stats": {
      "initialState": "idle",
      "states": ["idle", "proposed", "approved", "mutated", "verified", "completed", "no-change"],
      "terminalStates": ["completed", "no-change"],
      "transitions": [
        {"from": "idle", "to": "proposed", "phase": "propose", "jobs": ["generate"]},
        {"from": "proposed", "to": "no-change", "phase": "terminalize", "jobs": ["attest"]},
        {"from": "proposed", "to": "approved", "phase": "approve", "jobs": ["attest", "attest_publish", "stage"]},
        {"from": "approved", "to": "no-change", "phase": "terminalize", "jobs": ["stage"]},
        {"from": "approved", "to": "mutated", "phase": "mutate", "jobs": ["publish"]},
        {"from": "mutated", "to": "verified", "phase": "verify", "jobs": ["publish"]},
        {"from": "verified", "to": "completed", "phase": "terminalize", "jobs": ["dispatch"]}
      ]
    },
    "spotlight-link-sync": {
      "initialState": "idle",
      "states": ["idle", "proposed", "approved", "mutated", "verified", "completed", "no-change", "quarantined"],
      "terminalStates": ["completed", "no-change", "quarantined"],
      "transitions": [
        {"from": "idle", "to": "proposed", "phase": "propose", "jobs": ["plan"]},
        {"from": "proposed", "to": "no-change", "phase": "terminalize", "jobs": ["plan"]},
        {"from": "proposed", "to": "approved", "phase": "approve", "jobs": ["budget"]},
        {"from": "proposed", "to": "quarantined", "phase": "terminalize", "jobs": ["budget", "quarantine"]},
        {"from": "approved", "to": "mutated", "phase": "mutate", "jobs": ["propose"]},
        {"from": "mutated", "to": "verified", "phase": "verify", "jobs": ["approve"]},
        {"from": "verified", "to": "completed", "phase": "terminalize", "jobs": ["merge"]}
      ]
    }
  },
  "requiredChecks": [
    {
      "context": "validate-contracts",
      "workflow": "profile-quality",
      "job": "validate"
    },
    {
      "context": "integration-pinned-upstream",
      "workflow": "profile-quality",
      "job": "integration"
    },
    {
      "context": "dependency-review",
      "workflow": "dependency-review",
      "job": "dependency-review"
    },
    {
      "context": "analyze-actions",
      "workflow": "codeql",
      "job": "analyze"
    },
    {
      "context": "analyze-python",
      "workflow": "codeql",
      "job": "analyze"
    }
  ]
}
