{
  "automationPolicyId": "automation-policy-v1",
  "bomId": "workflow-capability-bom-v1",
  "repository": "portyu9/portyu9",
  "schemaVersion": 1,
  "workflows": [
    {
      "id": "capability-admission",
      "jobs": [
        {
          "actions": [
            {
              "kind": "remote",
              "path": "",
              "ref": "3d3c42e5aac5ba805825da76410c181273ba90b1",
              "repository": "actions/checkout",
              "step": "Checkout static trusted main"
            },
            {
              "kind": "remote",
              "path": "",
              "ref": "5fda3b95a4ea91299a34e894583c3862153e4b97",
              "repository": "actions/setup-python",
              "step": "Set up Python"
            }
          ],
          "apiSurfaces": [
            {
              "client": "gh-api",
              "endpoint": "repos/${DEPENDENCY_REPOSITORY}",
              "method": "GET",
              "mutating": false,
              "step": "Verify delegated Dependabot release provenance"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${DEPENDENCY_REPOSITORY}/releases/tags/${CANDIDATE_TAG}",
              "method": "GET",
              "mutating": false,
              "step": "Verify delegated Dependabot release provenance"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${HEAD_REPOSITORY}/git/blobs/${BLOB_SHA}",
              "method": "GET",
              "mutating": false,
              "step": "Fetch exact candidate capability source as data"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${HEAD_REPOSITORY}/git/blobs/${BLOB_SHA}",
              "method": "GET",
              "mutating": false,
              "step": "Fetch exact candidate capability source as data"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${HEAD_REPOSITORY}/git/commits/${HEAD_SHA}",
              "method": "GET",
              "mutating": false,
              "step": "Fetch exact candidate capability source as data"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${HEAD_REPOSITORY}/git/trees/${TREE_SHA}?recursive=1",
              "method": "GET",
              "mutating": false,
              "step": "Fetch exact candidate capability source as data"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/actions/artifacts/${ARTIFACT_ID}/zip",
              "method": "GET",
              "mutating": false,
              "step": "Verify immutable Autofix controller provenance"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}/attempts/${HISTORY_ATTEMPT}",
              "method": "GET",
              "mutating": false,
              "step": "Publish exact candidate trusted admission check"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/actions/runs/${ORIGIN_RUN_ID}/artifacts?per_page=100",
              "method": "GET",
              "mutating": false,
              "step": "Verify immutable Autofix controller provenance"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/actions/runs/${ORIGIN_RUN_ID}/attempts/${RECEIPT_ATTEMPT}",
              "method": "GET",
              "mutating": false,
              "step": "Verify immutable Autofix controller provenance"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/check-runs",
              "method": "POST",
              "mutating": true,
              "step": "Publish exact candidate trusted admission check"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/compare/${BASE_SHA}...${HEAD_SHA}",
              "method": "GET",
              "mutating": false,
              "step": "Bind exact candidate context"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/contents/README.md?ref=${HEAD_SHA}",
              "method": "GET",
              "mutating": false,
              "step": "Bind exact candidate context"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/git/commits/${HEAD_SHA}",
              "method": "GET",
              "mutating": false,
              "step": "Bind exact candidate context"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/git/ref/heads/${HEAD_REF}",
              "method": "GET",
              "mutating": false,
              "step": "Bind exact candidate context"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/git/ref/heads/generated",
              "method": "GET",
              "mutating": false,
              "step": "Bind exact candidate context"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/git/ref/heads/main",
              "method": "GET",
              "mutating": false,
              "step": "Bind exact candidate context"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/git/ref/heads/main",
              "method": "GET",
              "mutating": false,
              "step": "Bind exact candidate context"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/pulls?state=open&base=main&per_page=100",
              "method": "GET",
              "mutating": false,
              "step": "Bind exact candidate context"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/pulls/${PR_NUMBER}",
              "method": "GET",
              "mutating": false,
              "step": "Bind exact candidate context"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/pulls/${PR_NUMBER}",
              "method": "GET",
              "mutating": false,
              "step": "Bind exact candidate context"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/pulls/${PR_NUMBER}",
              "method": "GET",
              "mutating": false,
              "step": "Bind exact candidate context"
            },
            {
              "client": "gh-api",
              "endpoint": "repos/${TARGET_REPOSITORY}/pulls/${PR_NUMBER}/files?per_page=100",
              "method": "GET",
              "mutating": false,
              "step": "Fetch exact candidate capability source as data"
            },
            {
              "client": "git",
              "mutating": false,
              "operation": "ls-remote",
              "remote": "https://github.com/${DEPENDENCY_REPOSITORY}.git",
              "step": "Verify delegated Dependabot release provenance",
              "targets": [
                "\\"
              ]
            }
          ],
          "artifacts": [],
          "id": "admission",
          "mutations": [
            {
              "class": "github-api-post",
              "method": "POST",
              "step": "Publish exact candidate trusted admission check",
              "target": "repos/${TARGET_REPOSITORY}/check-runs"
            }
          ],
          "name": "trusted-capability-admission",
          "needs": [],
          "oidc": false,
          "permissions": {
            "actions": "read",
            "checks": "write",
            "contents": "read",
            "pull-requests": "read"
          },
          "references": {
            "env": [
              "PYTHON_VERSION"
            ],
            "githubToken": [
              "github.token"
            ],
            "secrets": [],
            "vars": []
          }
        }
      ],
      "name": "Capability admission",
      "path": ".github/workflows/capability-admission.yml",
      "references": {
        "env": [
          "PYTHON_VERSION"
        ],
        "githubToken": [
          "github.token"
        ],
        "secrets": [],
        "vars": []
      },
      "triggers": {
        "pull_request_target": {
          "types": [
            "opened",
            "reopened",
            "synchronize",
            "ready_for_review"
          ]
        },
        "repository_dispatch": {
          "types": [
            "codeql-autofix-admission",
            "dependabot-admission"
          ]
        },
        "schedule": {
          "cron": [
            "*/5 * * * *"
          ]
        },
        "workflow_dispatch": {}
      },
      "workflowPermissions": {
        "actions": "read",
        "checks": "write",
        "contents": "read",
        "pull-requests": "read"
      }
    }
  ]
}
